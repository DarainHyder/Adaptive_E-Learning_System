# Required in production: signs auth tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# LLM (Google Gemini via LangChain). Without a key the app runs in offline mode:
# question bank + curriculum-based lessons, rule-based hints.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Optional
# DATA_DIR=/data                      # defaults to /data on HF persistent storage, else ../data
# CORS_ORIGINS=http://localhost:3000,https://adaptive-e-learning-system.vercel.app
# SESSION_COOKIE_SECURE=false         # set false for plain-http local development
